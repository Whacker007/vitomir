{
  // Worked example 5: the module's own data changed by a scenario, and one clip's play rate for one actor.
  // Christof's blows from the right against a guard who stands; swept: where the side blows' contact window begins (the module's
  // combat/weapons.json, /activeWindow/strikeStarts/0/metres: the window opens once the blade's tip is within that many metres of
  // the guard's height) and how fast Christof's blow from the right plays (his clip "windup:right" at 0.8, 1 and 1.25 times its rate;
  // its contact window and busy time scale with it). --describe data lists every asset and pointer; --check lists an actor's clips
  // when a clip rate names none of them. What an earlier build measured: the press-to-contact time 0.767, 0.617 and 0.492 s by the clip's rate
  // (its falling trend passes); the window's start moves the window (it opens earlier with more metres: ScenarioOverrideTests) but
  // not this contact, which comes after the window has opened at every value at 1.3 m. Format vitomir-scenario/1.
  "format": "vitomir-scenario/1",
  "title": "A side blow's window start (module data) and its wind-up's play rate (one actor's clip), swept",
  "notes": "The combat rules' newly Embraced with the broadsword against the combat rules' trained guard (1000 Health, so no blow stops him), who only stands. The data override and the clip rate are each a setup condition in results.json (the value before and after, the asset's hash before and after); the clip rate is in actors.csv's clip_rates.",
  "ground": "free-yard",
  "time": "night",

  "actors": [
    {
      "name": "Christof",
      "template": "Christof",
      "sheet": { "template": "sandbox.newly_embraced" },
      "gear": { "weapon": "BroadSword", "shield": false },
      "place": [38, 9],
      "facing": { "toward": "Guard" },
      "foe": "Guard",
      "control": {
        "script": [
          { "mark": "blows begin" },
          { "repeat": 4, "steps": [ { "attack": "right", "aimAt": "chest" }, { "wait": 0.5 } ] },
          { "mark": "blows end" }
        ],
        "then": "stand"
      }
    },
    {
      "name": "Guard",
      "preset": "guard",
      "sheet": { "template": "sandbox.guard_trained", "values": { "health_pool": 1000 } },
      "gear": { "weapon": "Rapier", "shield": false },
      "place": { "from": "Christof", "distanceMetres": 1.3, "bearingDegrees": 0 },
      "facing": { "toward": "Christof" },
      "control": { "ai": "stand" }
    }
  ],

  "overrides": {
    // The module's data: a path under its Data/ and an RFC 6901 pointer into it (--describe data); the value must be the same JSON
    // kind as the one it replaces (here 0.1, a number). The module reads the changed file and checks it as its own.
    "data": [ { "asset": "combat/weapons.json", "pointer": "/activeWindow/strikeStarts/0/metres", "value": 0.1 } ],
    // One clip's play rate for one actor: a clip's name as the log's actions line names it, or quick | strong | block | hurt.
    "clipRate": [ { "actor": "Christof", "clip": "windup:right", "rate": 1.0 } ]
  },
  "stop": { "afterSeconds": 8, "onHarnessStops": "first",
            "when": [ { "count": { "event": "Marker", "by": "Christof", "where": { "text": "blows end" } }, "atLeast": 1 } ] },

  "runs": 10, "seed": 500,
  "sweep": [
    { "set": "/overrides/data/0/value", "values": [0.05, 0.1, 0.3] },   // a pointer or overrides.data.0.value
    { "set": "overrides.clipRate.0.rate", "values": [0.8, 1.0, 1.25] }
  ],

  "measures": [
    { "name": "blowsBegun",       "count": { "event": "AttackBegun", "by": "Christof" } },
    { "name": "windUpSeconds",    "delay": { "from": { "event": "AttackBegun", "by": "Christof" }, "to": { "event": "ContactMade", "by": "Christof" }, "pairBy": "swing" } },
    { "name": "bodyContactShare", "rate": { "of":  { "event": "ContactMade", "by": "Christof", "on": "Guard", "where": { "met": "body" } },
                                            "per": { "event": "AttackBegun", "by": "Christof" } } }
  ],
  "assertions": [
    { "name": "the wind-up quickens with its clip's rate", "measure": "windUpSeconds", "scope": "trend", "over": "overrides.clipRate.0.rate", "direction": "falling", "statistic": "median" },
    { "name": "every blow begun", "measure": "blowsBegun", "equals": 4, "scope": "eachRun" }
  ],
  "outputs": { "tracePolicy": "SAMPLED", "traceRuns": 1 }
}
