{
  // Worked example 7: the native half of the fixed-contact A/B (the output contract's Gate B: "fixed-contact compared to native
  // animated physical contacts"). Example 2's scripted blows (24: right at the chest, left at the upper arm, overhead at the head,
  // thrust at the belly, six times) by the combat rules' newly Embraced, Melee 2, against the combat rules' trained guard STANDING (no guard: every blow that
  // lands meets his body). Its traced runs' body contacts are made into fixed contacts at their own measured closing speed,
  // squareness, place on the blade, peak speed, region and time by tools/platform/scenarios/contact_ab.py (make), each run at its own
  // seed (example 8 is p000-r000's), and the harm compared contact by contact (contact_ab.py compare). Format vitomir-scenario/1.
  "format": "vitomir-scenario/1",
  "title": "The A/B's native half: example 2's scripted blows on a standing guard",
  "notes": "The combat rules' newly Embraced (Melee 2, the Rapier) and the combat rules' trained guard (the Rapier, no shield, 1000 Health), the guard standing. Every run traced (its body contacts are the fixed half's contacts).",
  "ground": "free-yard",
  "time": "night",

  "actors": [
    {
      "name": "Christof",
      "template": "Christof",
      "sheet": { "template": "sandbox.newly_embraced", "values": { "melee": 2 } },
      "gear": { "weapon": "Rapier", "shield": false },
      "place": [38, 3],
      "facing": { "toward": "Guard" },
      "foe": "Guard",
      "control": {
        "script": [
          { "moveTo": { "actor": "Guard", "distanceMetres": 1.3 }, "gait": "walk", "faceWhileMoving": "Guard", "withinMetres": 0.1,
            "forSeconds": 6, "label": "close in" },
          { "mark": "blows begin" },
          { "repeat": 6, "steps": [
              { "attack": "right",    "holdSeconds": 0.3, "aimAt": "chest" },
              { "wait": 0.6 },
              { "attack": "left",     "holdSeconds": 0.3, "aimAt": "upperArm" },
              { "wait": 0.6 },
              { "attack": "overhead", "holdSeconds": 0.4, "aimAt": "head" },
              { "wait": 0.6 },
              { "attack": "thrust",   "holdSeconds": 0.2, "aimAt": "belly" },
              { "wait": 0.6 },
              { "keepDistance": { "from": "Guard", "metres": 1.3, "toleranceMetres": 0.1 }, "gait": "walk", "forSeconds": 0.5 }
          ] },
          { "mark": "blows end" }
        ],
        "then": "stand"
      }
    },
    {
      "name": "Guard",
      "template": "rudolfGuard",
      "sheet": { "template": "sandbox.guard_trained", "values": { "health_pool": 1000 } }, // 1000 Health, so the 24 scripted blows all fall before he is stopped
      "gear": { "weapon": "Rapier", "shield": false },
      "place": { "from": "Christof", "distanceMetres": 3.0, "bearingDegrees": 0 },
      "facing": { "toward": "Christof" },
      "foe": "Christof",
      "control": { "ai": "stand" }   // stands, no guard: every blow that lands meets his body (the fixed half stands him the same)
    }
  ],

  "overrides": { "switches": [] },
  "stop": { "afterSeconds": 40, "onHarnessStops": "first",
            "when": [ { "count": { "event": "Marker", "by": "Christof", "where": { "text": "blows end" } }, "atLeast": 1 } ] },

  "runs": 20, "seed": 6000,

  "measures": [
    { "name": "blowsBegun",       "count": { "event": "AttackBegun", "by": "Christof", "fromMarker": "blows begin" } },
    { "name": "bodyContacts",     "count": { "event": "ContactMade", "by": "Christof", "on": "Guard", "where": { "met": "body" } } },
    { "name": "woundsPerContact", "rate": { "of":  { "event": "HarmResolved", "by": "Christof", "on": "Guard", "sum": "wounds" },
                                            "per": { "event": "ContactMade", "by": "Christof", "on": "Guard", "where": { "met": "body" } } } },
    { "name": "meanQuality",      "rate": { "of":  { "event": "HarmResolved", "by": "Christof", "on": "Guard", "sum": "quality" },
                                            "per": { "event": "HarmResolved", "by": "Christof", "on": "Guard" } } }
  ],
  "assertions": [
    { "name": "the script was carried out: 24 blows begun in every run", "measure": "blowsBegun", "equals": 24, "scope": "eachRun" },
    { "name": "no harm without a contact", "check": "noHarmWithoutContact", "isTrue": true, "scope": "eachRun" }
  ],
  "outputs": { "tracePolicy": "ALL", "csv": true, "summaryPage": false, "wideBouts": false }
}
