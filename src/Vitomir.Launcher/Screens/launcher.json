                  { "type": "list", "id": "noticeLines", "items": "noticeLines", "gap": 8,
                    "template": { "type": "column", "children": [ { "type": "text", "text": "{line}", "style": "body", "wrap": true, "visible": "plain" }, { "type": "text", "text": "{line}", "style": "warn", "wrap": true, "visible": "warn" }, { "type": "text", "text": "{line}", "style": "caution", "wrap": true, "visible": "caution" } ] } },
                  { "type": "checkbox", "id": "keepOld", "bind": "keepOld", "text": "Keep the old folder after the move", "action": "keepold", "wrap": true, "width": "fill", "visible": "noticeKeepOld" },
                  { "type": "text", "id": "keepOldNote", "text": "{keepOldNote}", "style": "note", "wrap": true, "visible": "noticeKeepOld" }
                ] } },
              { "type": "panel", "id": "noticeFrieze2", "fill": "rule", "height": 17 },
              { "type": "panel", "id": "noticeActions", "fill": "none", "padding": [49, 16, 49, 16],
                "child": { "type": "row", "gap": 24, "children": [
                  { "type": "button", "id": "noticeA", "text": "{noticeA}", "action": "notice", "arg": "a", "visible": "noticeA", "default": "noticeADefault", "cancel": "noticeACancel" },
                  { "type": "button", "id": "noticeB", "text": "{noticeB}", "action": "notice", "arg": "b", "visible": "noticeB", "default": "noticeBDefault", "cancel": "noticeBCancel" },
                  { "type": "button", "id": "noticeC", "text": "{noticeC}", "action": "notice", "arg": "c", "visible": "noticeC", "default": "noticeCDefault", "cancel": "noticeCCancel" }
                ] } }
            ]
          }
        }
      }
    ]
  }
}
