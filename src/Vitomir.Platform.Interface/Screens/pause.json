          { "type": "panel", "fill": "rule", "height": 2, "maxWidth": 260 },
          { "type": "space", "height": 14 },
          { "type": "button", "id": "resume", "text": "Resume", "action": "resume" },
          { "type": "button", "id": "controls", "text": "Controls", "action": "controls" },
          { "type": "button", "id": "quit", "text": "Quit", "action": "quit" }
