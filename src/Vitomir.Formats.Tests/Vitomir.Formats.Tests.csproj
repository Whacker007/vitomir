<Project Sdk="Microsoft.NET.Sdk">
  <!-- Format tests. The corpus tests read the player's own install (never stored in the repo):
       set VTMR_GAME_DIR to the game folder, or they look in C:\Games\VTMR, and skip if absent. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vitomir.Formats.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vitomir.Formats\Vitomir.Formats.csproj" />
  </ItemGroup>
</Project>
