<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine tests. The ones that need game data read the player's own install (never stored in the
       repo): set VTMR_GAME_DIR to the game folder, or they look in C:\Games\VTMR, and skip if absent. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vitomir.Engine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- The replay harness's baseline runs (ReplayBaselineTests): tapes of inputs and names, and their digests — no game content. -->
  <ItemGroup>
    <None Include="Replays\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vitomir.Engine\Vitomir.Engine.csproj" />
    <!-- The engine's tool code moved to vitomir-tools: the glTF export (GltfExportTests) and the level converter (L2LosslessTests, L2ReplayTests). -->
    <ProjectReference Include="..\Vitomir.Tools\Vitomir.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Classic snapshot's data types: the platform's. -->
    <Using Include="Vitomir.Platform.Presentation.Classic" />
  </ItemGroup>
  <ItemGroup>
    <!-- 1.1's character file built byte by byte: one builder, the Formats tests' own. -->
    <Compile Include="..\Vitomir.Formats.Tests\NpfBytes.cs" Link="NpfBytes.cs" />
  </ItemGroup>
</Project>
